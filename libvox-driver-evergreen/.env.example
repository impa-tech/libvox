# /libvox-driver-evergreen configuration. Copy to .env and edit.
#
# Standalone mode only. In production the connection block arrives in the
# invocation request, injected by /libvox-core at call time -- the driver reads
# no credentials from its own environment there.

# The Evergreen server, without a path. The driver adds /openapi3/v0 (the REST
# API) and /osrf-gateway-v1 (the OpenSRF gateway) itself.
EVERGREEN_URL=https://127.0.0.1

# A staff account. Evergreen has no API-key screen: access is always a login and
# a password. Give LibVox an account of its own, with permission to read the
# catalogue and nothing else -- LibVox never writes to an ILS.
EVERGREEN_USERNAME=
EVERGREEN_PASSWORD=

# Only for a server with a private certificate authority: a PEM bundle to trust
# instead of the system's. Never a switch that turns verification off.
# EVERGREEN_CA_BUNDLE=/path/to/ca.pem

LIBVOX_LOG_LEVEL=INFO
